[Unit]
Description=24/7 Android Battery Protection & Power Monitor
After=network.target multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/tommaso/repos/phone-battery-monitor/battery_monitor.py
WorkingDirectory=/home/tommaso/repos/phone-battery-monitor
EnvironmentFile=-%h/.config/portfolio-watch/env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
